# Telegram Bot Credentials (Used by Netlify Serverless Functions)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Supabase Configuration for Price Analysis Dashboard (Legacy / Alternative)
VITE_SUPABASE_URL=your_supase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Nhost Configuration (Frontend)
VITE_NHOST_SUBDOMAIN=local
VITE_NHOST_REGION=

# PostgreSQL Database Connection (Used by Netlify Serverless Functions)
POSTGRES_URL=postgres://postgres:password@localhost:5432/postgres

# Nhost DB Import Script URL (Optional, defaults to POSTGRES_URL if not provided)
NHOST_POSTGRES_URL=postgres://postgres:password@localhost:5432/postgres

# Telegram Userbot Configuration (Used in userbot/)
API_ID=your_api_id
API_HASH=your_api_hash
SESSION_STRING=your_session_string
TARGET_CHAT_ID=-1001234567890
WEBHOOK_URL=http://localhost:8888/.netlify/functions/telegram-webhook
PORT=3000
